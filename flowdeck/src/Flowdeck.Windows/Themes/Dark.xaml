<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Monochrome only. Emphasis comes from value and weight, never from hue. -->

  <Color x:Key="Color.Background">#0E0E10</Color>
  <Color x:Key="Color.Surface">#161719</Color>
  <Color x:Key="Color.SurfaceAlt">#1D1E21</Color>
  <Color x:Key="Color.SurfaceHover">#26272B</Color>
  <Color x:Key="Color.Border">#2A2C31</Color>
  <Color x:Key="Color.BorderStrong">#3C3F45</Color>
  <Color x:Key="Color.TextPrimary">#F3F3F4</Color>
  <Color x:Key="Color.TextSecondary">#A2A4A9</Color>
  <Color x:Key="Color.TextTertiary">#6B6D73</Color>
  <Color x:Key="Color.Accent">#FFFFFF</Color>
  <Color x:Key="Color.OnAccent">#0E0E10</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />

  <!-- By default weekend day numbers sit one step back from weekdays rather than turning red. -->
  <SolidColorBrush x:Key="Brush.Weekend" Color="{StaticResource Color.TextTertiary}" />

  <!-- Only used when the weekend colour option is switched on. Muted on purpose, so they
       read as an accent inside a grey palette rather than as warning colours. -->
  <SolidColorBrush x:Key="Brush.Saturday" Color="#6E9BE8" />
  <SolidColorBrush x:Key="Brush.Sunday" Color="#E8767C" />

  <Color x:Key="Color.Shadow">#000000</Color>

</ResourceDictionary>
