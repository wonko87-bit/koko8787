<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon: WPF has no NotifyIcon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Flowdeck</AssemblyName>
    <RootNamespace>Flowdeck.Windows</RootNamespace>
    <ApplicationIcon>Assets\flowdeck.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 tells Windows Forms apps to set high DPI in code instead of the
         manifest. This is a WPF app that only borrows NotifyIcon, and WPF reads its
         DPI awareness from the manifest, so the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Lets the project be compile-checked from a non-Windows agent. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms would otherwise import these globally, and almost every WPF
         type name (Application, MessageBox, Size, FontStyle, Cursor) has a Windows
         Forms twin. The tray icon is the only place that needs them, and it qualifies
         those types by hand. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowdeck.Core\Flowdeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\flowdeck.ico" />
  </ItemGroup>

</Project>
