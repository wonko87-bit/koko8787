<Window x:Class="Flowdeck.Windows.Views.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Flowdeck.Windows.Infrastructure"
        xmlns:vm="clr-namespace:Flowdeck.Windows.ViewModels"
        Title="Flowdeck 주소록"
        Width="460"
        Height="520"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.UI}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="Field" TargetType="Border">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Corner.Small}" />
    </Style>

    <DataTemplate DataType="{x:Type vm:ContactRow}">
      <Grid x:Name="Row" Margin="0,0,0,6" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Margin="0,0,6,0" Style="{StaticResource Field}">
          <Grid>
            <TextBlock Margin="0,0,3,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Text="@" />
            <TextBox Margin="13,0,0,0"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource Field}">
          <TextBox Style="{StaticResource TextBox.Flat}"
                   Text="{Binding Address, UpdateSourceTrigger=LostFocus}" />
        </Border>

        <Button x:Name="Delete"
                Grid.Column="2"
                Width="26"
                Height="26"
                VerticalAlignment="Center"
                Command="{Binding RemoveCommand}"
                Content="&#xE711;"
                FontFamily="{StaticResource Font.Icon}"
                FontSize="11"
                Opacity="0.45"
                Style="{StaticResource Button.Icon}"
                ToolTip="이 사람 지우기" />
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
        <DataTrigger Binding="{Binding IsNotValid}" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1"
          CornerRadius="{StaticResource Corner.Large}">
    <Grid Margin="22,16,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ title bar ============ -->
      <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.Title}" Text="주소록" />
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding CountLabel}" />
        </StackPanel>
        <Button HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="&#xE711;"
                FontFamily="{StaticResource Font.Icon}"
                FontSize="11"
                Style="{StaticResource Button.Icon}" />
      </Grid>

      <TextBlock Grid.Row="1"
                 Margin="0,10,0,14"
                 Style="{StaticResource Text.Meta}"
                 TextWrapping="Wrap"
                 Text="여기 등록한 이름은 입력할 때 @이름 으로 부를 수 있고, Teams 회의를 잡을 때 참석자로 들어갑니다." />

      <!-- ============ the list ============ -->
      <ScrollViewer Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
          <ItemsControl ItemsSource="{Binding Contacts}" />
          <TextBlock Margin="0,26,0,0"
                     HorizontalAlignment="Center"
                     Style="{StaticResource Text.Meta}"
                     Text="아직 등록된 사람이 없습니다"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </ScrollViewer>

      <!-- ============ add a row ============ -->
      <Grid Grid.Row="3" Margin="0,14,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="132" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Margin="0,0,6,0" Style="{StaticResource Field}">
          <Grid>
            <TextBlock Margin="0,0,3,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Text="@" />
            <TextBox x:Name="NewName"
                     Margin="13,0,0,0"
                     KeyDown="OnFieldKeyDown"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="입력할 때 부를 이름. 공백 없이" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource Field}">
          <TextBox KeyDown="OnFieldKeyDown"
                   Style="{StaticResource TextBox.Flat}"
                   Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="hong@corp.com" />
        </Border>

        <Button Grid.Column="2"
                Command="{Binding AddCommand}"
                Content="추가"
                Style="{StaticResource Button.Primary}" />
      </Grid>

      <TextBlock Grid.Row="4"
                 Margin="0,12,0,0"
                 Style="{StaticResource Text.Meta}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap" />
    </Grid>
  </Border>
</Window>
