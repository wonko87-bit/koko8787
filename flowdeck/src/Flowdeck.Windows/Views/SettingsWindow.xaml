<Window x:Class="Flowdeck.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flowdeck 설정"
        Width="460"
        Height="620"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.UI}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

  <Window.Resources>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1"
          CornerRadius="{StaticResource Corner.Large}">
    <Grid Margin="22,16,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ title bar ============ -->
      <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <TextBlock Style="{StaticResource Text.Title}" Text="설정" />
        <Button HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="&#xE711;"
                FontFamily="{StaticResource Font.Icon}"
                FontSize="11"
                Style="{StaticResource Button.Icon}" />
      </Grid>

      <ScrollViewer Grid.Row="1"
                    Margin="0,16,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

          <!-- ============ appearance ============ -->
          <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Section}" Text="화면" />

          <Grid Style="{StaticResource Row}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="테마" />
            <Border HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    CornerRadius="{StaticResource Corner.Small}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeDark"
                             Checked="OnThemeChanged"
                             Content="다크"
                             GroupName="Theme"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="ThemeLight"
                             Checked="OnThemeChanged"
                             Content="라이트"
                             GroupName="Theme"
                             Style="{StaticResource RadioButton.Segment}" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="위젯 표시 방식" />
              <TextBlock Style="{StaticResource Text.Meta}" Text="바탕화면 고정은 다른 창 뒤에 머무릅니다" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    CornerRadius="{StaticResource Corner.Small}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PinDesktop"
                             Checked="OnPinChanged"
                             Content="바탕화면"
                             GroupName="Pin"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="PinTop"
                             Checked="OnPinChanged"
                             Content="항상 위"
                             GroupName="Pin"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="PinNormal"
                             Checked="OnPinChanged"
                             Content="일반"
                             GroupName="Pin"
                             Style="{StaticResource RadioButton.Segment}" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="위젯 불투명도" />
            <Border HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    CornerRadius="{StaticResource Corner.Small}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Opacity60"
                             Checked="OnOpacityChanged"
                             Content="60%"
                             GroupName="Opacity"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="Opacity80"
                             Checked="OnOpacityChanged"
                             Content="80%"
                             GroupName="Opacity"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="Opacity92"
                             Checked="OnOpacityChanged"
                             Content="92%"
                             GroupName="Opacity"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="Opacity100"
                             Checked="OnOpacityChanged"
                             Content="100%"
                             GroupName="Opacity"
                             Style="{StaticResource RadioButton.Segment}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ calendar ============ -->
          <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="달력" />

          <Grid Style="{StaticResource Row}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="주 시작 요일" />
            <Border HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    CornerRadius="{StaticResource Corner.Small}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WeekStartMonday"
                             Checked="OnWeekStartChanged"
                             Content="월 ~ 일"
                             GroupName="WeekStart"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="WeekStartSunday"
                             Checked="OnWeekStartChanged"
                             Content="일 ~ 토"
                             GroupName="WeekStart"
                             Style="{StaticResource RadioButton.Segment}" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel Width="330" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="토요일 파랑 · 일요일 빨강" />
              <TextBlock Style="{StaticResource Text.Meta}"
                         Text="끄면 주말도 나머지와 같은 회색조로 표시됩니다"
                         TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="ColorWeekends"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource CheckBox.Setting}" />
          </Grid>

          <!-- ============ hot keys ============ -->
          <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="단축키" />

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="빠른 입력 열기" />
              <TextBlock Style="{StaticResource Text.Meta}" Text="예) Ctrl+Alt+Space" />
            </StackPanel>
            <Border Width="150"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corner.Small}">
              <TextBox x:Name="QuickAddHotkey"
                       IsReadOnly="True"
                       PreviewKeyDown="OnHotkeyCapture"
                       Style="{StaticResource TextBox.Flat}"
                       ToolTip="이 칸을 클릭한 뒤 원하는 조합을 누르세요" />
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="위젯 표시/숨기기" />
              <TextBlock Style="{StaticResource Text.Meta}" Text="예) Ctrl+Alt+D" />
            </StackPanel>
            <Border Width="150"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corner.Small}">
              <TextBox x:Name="ToggleWidgetHotkey"
                       IsReadOnly="True"
                       PreviewKeyDown="OnHotkeyCapture"
                       Style="{StaticResource TextBox.Flat}"
                       ToolTip="이 칸을 클릭한 뒤 원하는 조합을 누르세요" />
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="일정 목록 열기/닫기" />
              <TextBlock Style="{StaticResource Text.Meta}" Text="예) Ctrl+Alt+C" />
            </StackPanel>
            <Border Width="150"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corner.Small}">
              <TextBox x:Name="AgendaEventsHotkey"
                       IsReadOnly="True"
                       PreviewKeyDown="OnHotkeyCapture"
                       Style="{StaticResource TextBox.Flat}"
                       ToolTip="이 칸을 클릭한 뒤 원하는 조합을 누르세요" />
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="할일 목록 열기/닫기" />
              <TextBlock Style="{StaticResource Text.Meta}" Text="예) Ctrl+Alt+T" />
            </StackPanel>
            <Border Width="150"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corner.Small}">
              <TextBox x:Name="AgendaTodosHotkey"
                       IsReadOnly="True"
                       PreviewKeyDown="OnHotkeyCapture"
                       Style="{StaticResource TextBox.Flat}"
                       ToolTip="이 칸을 클릭한 뒤 원하는 조합을 누르세요" />
            </Border>
          </Grid>

          <TextBlock x:Name="HotkeyWarning"
                     Margin="0,-6,0,14"
                     Style="{StaticResource Text.Meta}"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <!-- ============ input behaviour ============ -->
          <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="입력 해석" />

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center" Width="250" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource Text.Body}" Text="표기가 없을 때 기본 분류" />
              <TextBlock x:Name="DefaultTargetHint"
                         Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    CornerRadius="{StaticResource Corner.Small}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DefaultAuto"
                             Checked="OnDefaultTargetChanged"
                             Content="자동"
                             GroupName="DefaultTarget"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="DefaultTodo"
                             Checked="OnDefaultTargetChanged"
                             Content="할일"
                             GroupName="DefaultTarget"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="DefaultCalendar"
                             Checked="OnDefaultTargetChanged"
                             Content="일정"
                             GroupName="DefaultTarget"
                             Style="{StaticResource RadioButton.Segment}" />
                <RadioButton x:Name="DefaultBoth"
                             Checked="OnDefaultTargetChanged"
                             Content="둘 다"
                             GroupName="DefaultTarget"
                             Style="{StaticResource RadioButton.Segment}" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Style="{StaticResource Row}">
            <StackPanel VerticalAlignment="Center" Width="330" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource Text.Body}" Text="'2시'를 오후로 해석" />
              <TextBlock Style="{StaticResource Text.Meta}"
                         Text="오전/오후 표기가 없는 1~7시를 오후로 읽습니다"
                         TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox x:Name="AfternoonBias"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource CheckBox.Setting}" />
          </Grid>

          <!-- ============ outlook ============ -->
          <!-- Hidden outright on a machine with no Outlook: nothing here would do anything. -->
          <StackPanel x:Name="OutlookSection" Visibility="Collapsed">
            <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="Outlook 연동" />

            <Grid Style="{StaticResource Row}">
              <StackPanel Width="330" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="Outlook 연동 사용" />
                <TextBlock Style="{StaticResource Text.Meta}"
                           Text="끄면 !OL 을 포함해 Outlook으로 나가는 동작이 모두 멈춥니다"
                           TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox x:Name="UseOutlook"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CheckBox.Setting}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
              <StackPanel Width="330" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="새 항목을 Outlook에도 저장" />
                <TextBlock Style="{StaticResource Text.Meta}"
                           Text="끄더라도 !OL 을 붙이면 그 항목만 보냅니다. 켠 뒤 !NOL 은 그 항목만 제외합니다."
                           TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox x:Name="PushToOutlook"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CheckBox.Setting}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
              <StackPanel Width="330" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="Outlook 일정 같이 보기" />
                <TextBlock Style="{StaticResource Text.Meta}"
                           Text="위젯에 회사 캘린더를 흐리게 겹쳐 보여줍니다. 읽기만 하고 고치지 않습니다."
                           TextWrapping="Wrap" />
              </StackPanel>
              <CheckBox x:Name="ShowOutlookCalendar"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Checked="OnCalendarOverlayChanged"
                        Unchecked="OnCalendarOverlayChanged"
                        Style="{StaticResource CheckBox.Setting}" />
            </Grid>

            <Grid x:Name="RefreshRow" Style="{StaticResource Row}">
              <StackPanel Width="200" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" Text="다시 읽는 주기" />
                <TextBlock x:Name="RefreshHint"
                           Style="{StaticResource Text.Meta}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Corner.Small}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Refresh5"
                                 Checked="OnRefreshPresetChanged"
                                 Content="5분"
                                 GroupName="Refresh"
                                 Style="{StaticResource RadioButton.Segment}" />
                    <RadioButton x:Name="Refresh10"
                                 Checked="OnRefreshPresetChanged"
                                 Content="10분"
                                 GroupName="Refresh"
                                 Style="{StaticResource RadioButton.Segment}" />
                    <RadioButton x:Name="Refresh30"
                                 Checked="OnRefreshPresetChanged"
                                 Content="30분"
                                 GroupName="Refresh"
                                 Style="{StaticResource RadioButton.Segment}" />
                    <RadioButton x:Name="Refresh60"
                                 Checked="OnRefreshPresetChanged"
                                 Content="1시간"
                                 GroupName="Refresh"
                                 Style="{StaticResource RadioButton.Segment}" />
                    <RadioButton x:Name="RefreshCustom"
                                 Checked="OnRefreshPresetChanged"
                                 Content="직접"
                                 GroupName="Refresh"
                                 Style="{StaticResource RadioButton.Segment}" />
                  </StackPanel>
                </Border>
                <Border Width="64"
                        Margin="8,0,0,0"
                        Padding="8,5"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Corner.Small}">
                  <Grid>
                    <TextBox x:Name="RefreshMinutes"
                             LostFocus="OnRefreshMinutesChanged"
                             Style="{StaticResource TextBox.Flat}"
                             ToolTip="분 단위" />
                  </Grid>
                </Border>
                <TextBlock Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.Meta}"
                           Text="분" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- ============ teams ============ -->
          <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="Teams 회의" />

          <Grid Style="{StaticResource Row}">
            <StackPanel Width="290" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Body}" Text="주소록" />
              <TextBlock x:Name="ContactsSummary"
                         Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnContactsClick"
                    Content="주소록 편집"
                    Style="{StaticResource Button.Ghost}" />
          </Grid>

          <!-- ============ system ============ -->
          <TextBlock Margin="0,8,0,8" Style="{StaticResource Text.Section}" Text="시스템" />

          <Grid Style="{StaticResource Row}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="Windows 시작 시 자동 실행" />
            <CheckBox x:Name="LaunchAtStartup"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource CheckBox.Setting}" />
          </Grid>

          <Grid Style="{StaticResource Row}">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="시작할 때 위젯 표시" />
            <CheckBox x:Name="ShowWidgetOnStart"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource CheckBox.Setting}" />
          </Grid>

          <!-- ============ transfer ============ -->
          <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Section}" Text="자료 주고받기" />
          <TextBlock Margin="0,0,0,10"
                     Style="{StaticResource Text.Meta}"
                     TextWrapping="Wrap"
                     Text="다른 PC의 Flowdeck에서 내보낸 파일을 이 목록에 더합니다. 있는 항목은 건드리지 않고, 같은 파일을 두 번 넣어도 중복되지 않습니다. 내보내기는 목록 창(Ctrl+Alt+C / T) 오른쪽 위 버튼에 있습니다." />

          <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Click="OnImportClick"
                    Content="파일에서 가져오기"
                    Style="{StaticResource Button.Primary}" />
            <Button Click="OnExportClick"
                    Content="일정 .ics 내보내기"
                    Style="{StaticResource Button.Ghost}" />
          </StackPanel>

          <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
            <Button Click="OnOpenFolderClick"
                    Content="데이터 폴더 열기"
                    Style="{StaticResource Button.Ghost}" />
          </StackPanel>

          <!-- ============ syntax reference ============ -->
          <TextBlock Margin="0,20,0,8" Style="{StaticResource Text.Section}" Text="입력 문법" />
          <Border Padding="14,12"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource Corner.Medium}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap"
                         LineHeight="19"><Run FontWeight="SemiBold" Text="분류" /><LineBreak /><Run Text="!TD · /t · 할일 → 할일만" /><LineBreak /><Run Text="!CD · /c · 일정 → 달력만" /><LineBreak /><Run Text="!BD · /b · 둘다 → 양쪽 모두" /><LineBreak /><Run Text="표기가 없으면 양쪽 모두에 저장됩니다" /></TextBlock>
              <Border Height="1" Margin="0,10" Background="{DynamicResource Brush.Border}" />
              <TextBlock Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap"
                         LineHeight="19"><Run FontWeight="SemiBold" Text="날짜와 시간" /><LineBreak /><Run Text="오늘 · 내일 · 모레 · 글피 · 3일 후" /><LineBreak /><Run Text="다음주 월요일 · 이번주 금요일 · 주말" /><LineBreak /><Run Text="8월 12일 · 2026-08-12 · 9/15 · 20일" /><LineBreak /><Run Text="오후 3시 · 3시 반 · 14:30 · 저녁 7시" /><LineBreak /><Run Text="3시~5시 · 10시부터 1시까지 · 2시간" /></TextBlock>
              <Border Height="1" Margin="0,10" Background="{DynamicResource Brush.Border}" />
              <TextBlock Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap"
                         LineHeight="19"><Run FontWeight="SemiBold" Text="반복 · 우선순위 · 태그 · 알림" /><LineBreak /><Run Text="매일 · 평일 · 매주 화요일 · 격주 · 매월 · 3일마다" /><LineBreak /><Run Text="!1 (가장 급함) ~ !4" /><LineBreak /><Run Text="#태그" /><LineBreak /><Run Text="30분 전 알림 · 1시간 전 알림" /></TextBlock>
              <Border Height="1" Margin="0,10" Background="{DynamicResource Brush.Border}" />
              <TextBlock Style="{StaticResource Text.Meta}"
                         TextWrapping="Wrap"
                         LineHeight="19"><Run FontWeight="SemiBold" Text="메모" /><LineBreak /><Run Text="/* 뒤로는 전부 메모 (닫는 */ 는 생략 가능)" /><LineBreak /><Run Text="메모 안의 날짜와 #태그는 해석하지 않습니다" /><LineBreak /><Run Text="줄바꿈은 \n" /></TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ footer ============ -->
      <Grid Grid.Row="2" Margin="0,14,0,0">
        <TextBlock x:Name="StatusText"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Meta}" />
        <Button HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="완료"
                Style="{StaticResource Button.Primary}" />
      </Grid>
    </Grid>
  </Border>
</Window>
