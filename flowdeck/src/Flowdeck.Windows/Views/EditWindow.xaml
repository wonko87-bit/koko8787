<Window x:Class="Flowdeck.Windows.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Flowdeck.Windows.Infrastructure"
        Title="Flowdeck 편집"
        Width="440"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.UI}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="Field" TargetType="Border">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Corner.Small}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
      <Setter Property="Margin" Value="2,0,0,5" />
    </Style>

    <!-- The flat box is built for one line: its template centres the content and pins the
         scrollbars to Hidden, neither of which a note can live with. Same look, but the
         content sits at the top and the box's own scrollbar setting is honoured. -->
    <Style x:Key="NoteBox" TargetType="TextBox" BasedOn="{StaticResource TextBox.Flat}">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Corner.Small}"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1"
          CornerRadius="{StaticResource Corner.Large}">
    <StackPanel Margin="22,16,22,18">

      <!-- ============ title bar ============ -->
      <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding HeaderLabel}" />
        <Button HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="&#xE711;"
                FontFamily="{StaticResource Font.Icon}"
                FontSize="11"
                Style="{StaticResource Button.Icon}" />
      </Grid>

      <!-- ============ title ============ -->
      <TextBlock Margin="2,16,0,5" Style="{StaticResource Text.Meta}" Text="제목" />
      <Border Style="{StaticResource Field}">
        <TextBox x:Name="TitleBox"
                 KeyDown="OnFieldKeyDown"
                 Style="{StaticResource TextBox.Flat}"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
      </Border>

      <!-- ============ the note ============ -->
      <TextBlock Margin="2,14,0,5" Style="{StaticResource Text.Meta}" Text="메모" />
      <Border Style="{StaticResource Field}">
        <TextBox Height="104"
                 KeyDown="OnFieldKeyDown"
                 Style="{StaticResource NoteBox}"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
      </Border>
      <TextBlock Margin="2,5,0,0"
                 Style="{StaticResource Text.Meta}"
                 Text="여기서는 줄바꿈을 그대로 쓰면 됩니다 (Enter)" />

      <!-- ============ when ============ -->
      <Grid Margin="0,16,0,0">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Meta}" Text="날짜" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <CheckBox VerticalAlignment="Center"
                    IsChecked="{Binding HasDate, Mode=TwoWay}"
                    IsEnabled="{Binding CanClearDate}"
                    Style="{StaticResource CheckBox.Setting}"
                    ToolTip="일정은 달력에 자리가 있어야 하므로 날짜를 지울 수 없습니다" />
          <TextBlock Margin="14,0,6,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.Meta}"
                     Text="시각" />
          <CheckBox VerticalAlignment="Center"
                    IsChecked="{Binding HasTime, Mode=TwoWay}"
                    IsEnabled="{Binding HasDate}"
                    Style="{StaticResource CheckBox.Setting}" />
        </StackPanel>
      </Grid>

      <Grid Margin="0,8,0,0" Visibility="{Binding HasDate, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Field}">
          <TextBox KeyDown="OnFieldKeyDown"
                   Style="{StaticResource TextBox.Flat}"
                   Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="2026-08-12" />
        </Border>

        <Border Grid.Column="1"
                Width="92"
                Margin="8,0,0,0"
                Style="{StaticResource Field}"
                Visibility="{Binding ShowTime, Converter={StaticResource BoolToVisibility}}">
          <TextBox KeyDown="OnFieldKeyDown"
                   Style="{StaticResource TextBox.Flat}"
                   Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="14:30" />
        </Border>
      </Grid>

      <!-- ============ tags and the reminder ============ -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="태그" />
          <Border Style="{StaticResource Field}">
            <TextBox KeyDown="OnFieldKeyDown"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="#업무 #보고" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="112" Margin="8,0,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" Text="알림 (분 전)" />
          <Border Style="{StaticResource Field}">
            <TextBox KeyDown="OnFieldKeyDown"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding Reminder, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="비우면 알림 없음" />
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ priority ============ -->
      <Grid Margin="0,16,0,0" Visibility="{Binding ShowPriority, Converter={StaticResource BoolToVisibility}}">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Meta}" Text="우선순위" />
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.SurfaceAlt}"
                CornerRadius="{StaticResource Corner.Small}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="1"
                         GroupName="Priority"
                         IsChecked="{Binding IsUrgent, Mode=TwoWay}"
                         Style="{StaticResource RadioButton.Segment}" />
            <RadioButton Content="2"
                         GroupName="Priority"
                         IsChecked="{Binding IsHigh, Mode=TwoWay}"
                         Style="{StaticResource RadioButton.Segment}" />
            <RadioButton Content="3"
                         GroupName="Priority"
                         IsChecked="{Binding IsNormal, Mode=TwoWay}"
                         Style="{StaticResource RadioButton.Segment}" />
            <RadioButton Content="4"
                         GroupName="Priority"
                         IsChecked="{Binding IsLow, Mode=TwoWay}"
                         Style="{StaticResource RadioButton.Segment}" />
            <RadioButton Content="없음"
                         GroupName="Priority"
                         IsChecked="{Binding IsNoPriority, Mode=TwoWay}"
                         Style="{StaticResource RadioButton.Segment}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Margin="2,14,0,0"
                 Style="{StaticResource Text.Meta}"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

      <!-- ============ footer ============ -->
      <Grid Margin="0,18,0,0">
        <Button HorizontalAlignment="Left"
                Command="{Binding DeleteCommand}"
                Content="삭제"
                Style="{StaticResource Button.Ghost}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,8,0"
                  Click="OnCloseClick"
                  Content="취소"
                  Style="{StaticResource Button.Ghost}" />
          <Button Command="{Binding SaveCommand}"
                  Content="저장"
                  IsDefault="True"
                  Style="{StaticResource Button.Primary}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Window>
