<Window x:Class="Flowdeck.Windows.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Flowdeck.Windows.Infrastructure"
        Title="Flowdeck 빠른 입력"
        Width="620"
        AllowsTransparency="True"
        Background="Transparent"
        Deactivated="OnDeactivated"
        FontFamily="{StaticResource Font.UI}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:StringToVisibilityConverter x:Key="StringToVisibility" />

    <!-- Small monochrome chip used for every derived fact in the preview row. -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1"
          CornerRadius="{StaticResource Corner.Large}">
    <StackPanel Margin="20,16,20,14">

      <!-- ============ the input line ============ -->
      <Grid>
        <TextBlock VerticalAlignment="Center"
                   FontSize="19"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   IsHitTestVisible="False"
                   Text="무엇을 기록할까요?  예) 내일 오후 3시 팀 회의"
                   Visibility="{Binding Input, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
        <TextBox x:Name="Input"
                 FontSize="19"
                 PreviewKeyDown="OnInputKeyDown"
                 Style="{StaticResource TextBox.Flat}"
                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>

      <Border Height="1"
              Margin="0,12,0,0"
              Background="{DynamicResource Brush.Border}" />

      <!-- ============ live reading of what was typed ============ -->
      <Grid Margin="0,12,0,0" Visibility="{Binding HasInput, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <Border Background="{DynamicResource Brush.Accent}"
                  BorderBrush="{DynamicResource Brush.Accent}"
                  Style="{StaticResource Chip}">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.OnAccent}"
                       Text="{Binding TargetLabel}" />
          </Border>

          <TextBlock VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     Text="{Binding TitlePreview}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
          <Border Style="{StaticResource Chip}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding SchedulePreview}" />
          </Border>
          <Border Style="{StaticResource Chip}"
                  Visibility="{Binding HasRecurrence, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding RecurrenceLabel}" />
          </Border>
          <Border Style="{StaticResource Chip}"
                  Visibility="{Binding HasPriority, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding PriorityLabel}" />
          </Border>
          <Border Style="{StaticResource Chip}"
                  Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding ReminderLabel}" />
          </Border>
          <Border Style="{StaticResource Chip}"
                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding TagLabel}" />
          </Border>
          <Border BorderBrush="{DynamicResource Brush.BorderStrong}"
                  Style="{StaticResource Chip}"
                  Visibility="{Binding PushesToOutlook, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="→ Outlook" />
          </Border>
          <Border Style="{StaticResource Chip}"
                  Visibility="{Binding HasAttendees, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding AttendeeLabel}" />
          </Border>
          <Border BorderBrush="{DynamicResource Brush.BorderStrong}"
                  Style="{StaticResource Chip}"
                  Visibility="{Binding OpensTeamsMeeting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="→ Teams 회의 폼" />
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ key legend ============ -->
      <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   Text="Enter 저장 · Esc 닫기 · Ctrl+1 할일 · Ctrl+2 일정 · Ctrl+3 둘 다 · Ctrl+O Outlook · Ctrl+M Teams" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
