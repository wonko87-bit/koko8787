<Window x:Class="Flowdeck.Windows.Views.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Flowdeck.Windows.Infrastructure"
        xmlns:vm="clr-namespace:Flowdeck.Windows.ViewModels"
        Title="Flowdeck"
        Width="420"
        Height="620"
        MinWidth="340"
        MinHeight="380"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.UI}"
        PreviewKeyDown="OnPreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:StringToVisibilityConverter x:Key="StringToVisibility" />

    <Style x:Key="Row.Delete" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- The two row types are matched by DataType, so one list can hold either. -->
    <DataTemplate DataType="{x:Type vm:EventRow}">
      <Grid x:Name="Row" Margin="0,0,0,4" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="58" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Margin="0,1,10,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource Text.Meta}"
                   Text="{Binding TimeLabel}" />

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Text.Body}"
                     Text="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Meta}"
                       Text="{Binding RangeLabel}"
                       Visibility="{Binding RangeLabel, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Margin="8,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding RecurrenceLabel}"
                       Visibility="{Binding RecurrenceLabel, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Margin="8,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding TagLabel}"
                       Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <Button x:Name="Delete"
                Grid.Column="2"
                Command="{Binding DeleteCommand}"
                Content="&#xE711;"
                Style="{StaticResource Row.Delete}"
                ToolTip="삭제" />
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TodoRow}">
      <Grid x:Name="Row" Margin="0,0,0,4" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox Margin="0,2,10,0"
                  VerticalAlignment="Top"
                  IsChecked="{Binding IsDone, Mode=TwoWay}"
                  Style="{StaticResource CheckBox.Todo}" />

        <StackPanel Grid.Column="1">
          <TextBlock x:Name="TitleText"
                     Style="{StaticResource Text.Body}"
                     Text="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DueText"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding DueLabel}"
                       Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="8,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding RecurrenceLabel}"
                       Visibility="{Binding RecurrenceLabel, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Margin="8,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding TagLabel}"
                       Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Margin="4,1,0,0"
                     VerticalAlignment="Top"
                     FontWeight="Bold"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding PriorityLabel}"
                     Visibility="{Binding HasPriority, Converter={StaticResource BoolToVisibility}}" />
          <Button x:Name="Delete"
                  Command="{Binding DeleteCommand}"
                  Content="&#xE711;"
                  Style="{StaticResource Row.Delete}"
                  ToolTip="삭제" />
        </StackPanel>
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
          <Setter TargetName="DueText" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A repeat rule on one line: title, the pattern in brackets, then the next date. -->
    <DataTemplate DataType="{x:Type vm:RecurringRow}">
      <Grid x:Name="Row" Margin="0,0,0,5" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox Margin="0,2,10,0"
                  VerticalAlignment="Top"
                  IsChecked="{Binding IsDone, Mode=TwoWay}"
                  Style="{StaticResource CheckBox.Todo}"
                  ToolTip="완료하고 다음 차례로 넘기기"
                  Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.Body}"
                     Text="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="7,0,0,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding PatternLabel}" />
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextTertiary}"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding TagLabel}"
                     Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.TextTertiary}"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding NextLabel}"
                     Visibility="{Binding NextLabel, Converter={StaticResource StringToVisibility}}" />
          <Button x:Name="Delete"
                  Command="{Binding DeleteCommand}"
                  Content="&#xE711;"
                  Style="{StaticResource Row.Delete}"
                  ToolTip="반복 삭제" />
        </StackPanel>
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One day: a heading with a count, then its entries. -->
    <DataTemplate DataType="{x:Type vm:AgendaGroup}">
      <StackPanel x:Name="GroupRoot" Margin="0,0,0,16">
        <Grid Margin="0,0,0,7">
          <TextBlock x:Name="Head"
                     Style="{StaticResource Text.Section}"
                     Text="{Binding Header}" />
          <Border HorizontalAlignment="Right"
                  Padding="6,1"
                  Background="{DynamicResource Brush.SurfaceAlt}"
                  CornerRadius="4">
            <TextBlock FontSize="10"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Text="{Binding CountLabel}" />
          </Border>
        </Grid>

        <Border Height="1"
                Margin="0,0,0,8"
                Background="{DynamicResource Brush.Border}" />

        <ItemsControl ItemsSource="{Binding Items}" />
      </StackPanel>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPast}" Value="True">
          <Setter TargetName="GroupRoot" Property="Opacity" Value="0.62" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsToday}" Value="True">
          <Setter TargetName="Head" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsUndated}" Value="True">
          <Setter TargetName="GroupRoot" Property="Opacity" Value="0.82" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1"
          CornerRadius="{StaticResource Corner.Large}">
    <Grid Margin="20,14,20,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ header, doubles as the drag handle ============ -->
      <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Bottom"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding TotalLabel}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <CheckBox x:Name="ShowCompleted"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ShowCompleted, Mode=TwoWay}"
                    Style="{StaticResource CheckBox.Setting}"
                    ToolTip="완료한 항목도 표시"
                    Visibility="{Binding IsTodoMode, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.Meta}"
                     Text="완료 포함"
                     Visibility="{Binding IsTodoMode, Converter={StaticResource BoolToVisibility}}" />
          <Button Click="OnCloseClick"
                  Content="&#xE711;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="11"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="닫기 (Esc)" />
        </StackPanel>
      </Grid>

      <!-- ============ the list ============ -->
      <ScrollViewer Grid.Row="1"
                    Margin="0,14,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <Grid>
            <ItemsControl ItemsSource="{Binding Groups}" />
            <TextBlock Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding EmptyMessage}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
          </Grid>

          <!-- ============ repeats, gathered at the bottom ============ -->
          <StackPanel Visibility="{Binding HasRecurring, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="0,4,0,7">
              <TextBlock Style="{StaticResource Text.Section}" Text="{Binding RecurringSectionLabel}" />
            </Grid>
            <Border Height="1"
                    Margin="0,0,0,8"
                    Background="{DynamicResource Brush.Border}" />
            <ItemsControl ItemsSource="{Binding Recurring}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Thumb x:Name="ResizeGrip"
             Grid.Row="2"
             Width="16"
             Height="16"
             Margin="0,0,-12,-10"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Cursor="SizeNWSE"
             DragDelta="OnResize"
             Opacity="0">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Rectangle Fill="Transparent" />
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
