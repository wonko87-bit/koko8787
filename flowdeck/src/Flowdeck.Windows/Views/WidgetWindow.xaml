<Window x:Class="Flowdeck.Windows.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Flowdeck.Windows.Infrastructure"
        Title="Flowdeck"
        Width="340"
        Height="620"
        MinWidth="300"
        MinHeight="420"
        MaxWidth="440"
        MaxHeight="1000"
        SizeChanged="OnWidgetSizeChanged"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Font.UI}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">

  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:StringToVisibilityConverter x:Key="StringToVisibility" />

    <!-- One cell of the month grid. -->
    <Style x:Key="Day.Button" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Margin="1" Background="Transparent">
              <Border x:Name="Chip"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="8" />
              <StackPanel Margin="0,3,0,2" VerticalAlignment="Center">
                <TextBlock x:Name="Num"
                           HorizontalAlignment="Center"
                           FontSize="{Binding DataContext.DayFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{Binding DayNumber}" />
                <StackPanel Height="4"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                  <Ellipse x:Name="EventDot"
                           Width="3"
                           Height="3"
                           Margin="1,0"
                           Fill="{DynamicResource Brush.TextSecondary}"
                           Visibility="Collapsed" />
                  <Ellipse x:Name="TodoDot"
                           Width="3"
                           Height="3"
                           Margin="1,0"
                           Fill="{DynamicResource Brush.TextTertiary}"
                           Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding HasEvents}" Value="True">
                <Setter TargetName="EventDot" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasTodos}" Value="True">
                <Setter TargetName="TodoDot" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Weekend}" />
              </DataTrigger>

              <!-- Opt-in only; the grey above stays the default. -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ColorWeekends}" Value="True" />
                  <Condition Binding="{Binding IsSaturday}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Saturday}" />
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ColorWeekends}" Value="True" />
                  <Condition Binding="{Binding IsSunday}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.Sunday}" />
              </MultiDataTrigger>

              <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                <Setter TargetName="Num" Property="Opacity" Value="0.32" />
                <Setter TargetName="EventDot" Property="Opacity" Value="0.32" />
                <Setter TargetName="TodoDot" Property="Opacity" Value="0.32" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                <Setter TargetName="Num" Property="Opacity" Value="1" />
                <Setter TargetName="EventDot" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                <Setter TargetName="TodoDot" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Delete affordance: hidden until the row is hovered, so the list stays quiet. -->
    <Style x:Key="Row.Delete" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <DataTemplate x:Key="EventTemplate">
      <Grid x:Name="Row" Margin="0,0,0,2" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Margin="0,1,8,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource Text.Meta}"
                   Text="{Binding TimeLabel}" />

        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource Text.Body}"
                     Text="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Foreground="{DynamicResource Brush.TextTertiary}"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding NotePreview}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Notes}"
                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Meta}"
                       Text="{Binding RecurrenceLabel}"
                       Visibility="{Binding RecurrenceLabel, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Margin="6,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding TagLabel}"
                       Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <Button x:Name="Delete"
                Grid.Column="2"
                Command="{Binding DeleteCommand}"
                Content="&#xE711;"
                Style="{StaticResource Row.Delete}"
                ToolTip="삭제" />
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="TodoTemplate">
      <Grid x:Name="Row" Margin="0,0,0,3" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <CheckBox Margin="0,2,9,0"
                  VerticalAlignment="Top"
                  IsChecked="{Binding IsDone, Mode=TwoWay}"
                  Style="{StaticResource CheckBox.Todo}" />

        <StackPanel Grid.Column="1">
          <TextBlock x:Name="TitleText"
                     Style="{StaticResource Text.Body}"
                     Text="{Binding Title}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Foreground="{DynamicResource Brush.TextTertiary}"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding NotePreview}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Notes}"
                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DueText"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding DueLabel}"
                       Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Margin="6,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding RecurrenceLabel}"
                       Visibility="{Binding RecurrenceLabel, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Margin="6,0,0,0"
                       Style="{StaticResource Text.Meta}"
                       Text="{Binding TagLabel}"
                       Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Margin="4,1,0,0"
                     VerticalAlignment="Top"
                     FontWeight="Bold"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding PriorityLabel}"
                     Visibility="{Binding HasPriority, Converter={StaticResource BoolToVisibility}}" />
          <Button x:Name="Delete"
                  Command="{Binding DeleteCommand}"
                  Content="&#xE711;"
                  Style="{StaticResource Row.Delete}"
                  ToolTip="삭제" />
        </StackPanel>
      </Grid>

      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Delete" Property="Opacity" Value="1" />
        </Trigger>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
          <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
          <Setter TargetName="DueText" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="Root"
          Background="{DynamicResource Brush.Background}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          CornerRadius="14">
    <Grid Margin="14,12,14,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ============ header: doubles as the drag handle ============ -->
      <Grid x:Name="DragHandle" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Title}" Text="{Binding MonthTitle}" />
          <TextBlock Margin="0,1,0,0"
                     Style="{StaticResource Text.Meta}"
                     Text="{Binding SelectedDateLabel}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Command="{Binding PreviousMonthCommand}"
                  Content="&#xE76B;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="11"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="이전 달" />
          <Button Command="{Binding TodayCommand}"
                  Content="&#xE8BF;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="12"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="오늘" />
          <Button Command="{Binding NextMonthCommand}"
                  Content="&#xE76C;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="11"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="다음 달" />
          <Button Click="OnSettingsClick"
                  Content="&#xE713;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="12"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="설정" />
          <Button Click="OnHideClick"
                  Content="&#xE711;"
                  FontFamily="{StaticResource Font.Icon}"
                  FontSize="11"
                  Style="{StaticResource Button.Icon}"
                  ToolTip="위젯 숨기기" />
        </StackPanel>
      </Grid>

      <!-- ============ month grid ============ -->
      <StackPanel Grid.Row="1" Margin="0,10,0,0">
        <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock x:Name="Head"
                         Margin="0,0,0,5"
                         HorizontalAlignment="Center"
                         Style="{StaticResource Text.Section}"
                         Text="{Binding Label}" />
              <DataTemplate.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ColorWeekends}" Value="True" />
                    <Condition Binding="{Binding IsSaturday}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="Head" Property="Foreground" Value="{DynamicResource Brush.Saturday}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ColorWeekends}" Value="True" />
                    <Condition Binding="{Binding IsSunday}" Value="True" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="Head" Property="Foreground" Value="{DynamicResource Brush.Sunday}" />
                </MultiDataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" Rows="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Height="{Binding DataContext.DayCellSize, RelativeSource={RelativeSource AncestorType=Window}}"
                      Command="{Binding SelectCommand}"
                      Style="{StaticResource Day.Button}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Sits directly under the grid, so it travels down as the cells grow. -->
        <Border Height="1"
                Margin="0,12,0,0"
                Background="{DynamicResource Brush.Border}" />
      </StackPanel>

      <!-- ============ the selected day ============ -->
      <ScrollViewer Grid.Row="2"
                    Margin="0,10,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Margin="0,0,0,6">
            <TextBlock Style="{StaticResource Text.Section}" Text="일정" />
            <Button HorizontalAlignment="Right"
                    Padding="6,1"
                    Click="OnEventsAgendaClick"
                    Content="전체"
                    FontSize="10"
                    Style="{StaticResource Button.Ghost}"
                    ToolTip="누적 일정 전체 보기" />
          </Grid>
          <ItemsControl ItemTemplate="{StaticResource EventTemplate}" ItemsSource="{Binding Events}" />
          <TextBlock Margin="0,0,0,4"
                     Style="{StaticResource Text.Meta}"
                     Text="등록된 일정이 없습니다"
                     Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

          <Grid Margin="0,14,0,6">
            <TextBlock Style="{StaticResource Text.Section}" Text="{Binding TodoSectionLabel}" />
            <Button HorizontalAlignment="Right"
                    Padding="6,1"
                    Click="OnTodosAgendaClick"
                    Content="전체"
                    FontSize="10"
                    Style="{StaticResource Button.Ghost}"
                    ToolTip="누적 할일 전체 보기" />
          </Grid>
          <ItemsControl ItemTemplate="{StaticResource TodoTemplate}" ItemsSource="{Binding Todos}" />
          <TextBlock Style="{StaticResource Text.Meta}"
                     Text="할일이 없습니다"
                     Visibility="{Binding HasTodos, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>
      </ScrollViewer>

      <!-- ============ inline capture ============ -->
      <StackPanel Grid.Row="3" Margin="0,10,0,0">
        <Border Padding="10,8"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Corner.Medium}">
          <Grid>
            <TextBlock Style="{StaticResource Text.Body}"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       IsHitTestVisible="False"
                       Text="예) 내일 오후 3시 팀 회의"
                       Visibility="{Binding QuickInput, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}" />
            <TextBox x:Name="InlineInput"
                     KeyDown="OnInlineInputKeyDown"
                     Style="{StaticResource TextBox.Flat}"
                     Text="{Binding QuickInput, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Border>

        <TextBlock Margin="2,5,0,0"
                   Style="{StaticResource Text.Meta}"
                   Text="{Binding PreviewText}"
                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <!-- Bottom-right resize grip. -->
      <Thumb x:Name="ResizeGrip"
             Grid.Row="3"
             Width="14"
             Height="14"
             Margin="0,0,-8,-8"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Cursor="SizeNWSE"
             DragDelta="OnResize"
             Opacity="0">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Rectangle Fill="Transparent" />
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
