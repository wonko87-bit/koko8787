<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:label="Flowdeck"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true" />

  <!-- Everything is stored inside the app's own directory, so no storage permission is
       needed. Reading an imported file goes through the system picker, which grants access
       to that one file, and sharing goes out through the share sheet. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <queries>
    <!-- Lets the share sheet see which apps can receive a file. Required from Android 11
         onwards, where package visibility is filtered by default. -->
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="*/*" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>
</manifest>
