<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flowdeck.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>

    <ApplicationTitle>Flowdeck</ApplicationTitle>
    <ApplicationId>com.flowdeck.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 5.0. Nothing here needs anything newer. -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>

    <!-- An .aab cannot be sideloaded, and sideloading is how this app gets onto a
         phone: there is no store listing and no signing identity behind it. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F0F0F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F0F0F" BaseSize="160,160" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same assembly the desktop app uses, unchanged: parser, routing, recurrence,
         storage and the transfer format all live there and know nothing of either UI. -->
    <ProjectReference Include="..\Flowdeck.Core\Flowdeck.Core.csproj" />
  </ItemGroup>

</Project>
