<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Flowdeck.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Flowdeck.Mobile.Views"
       FlyoutBehavior="Disabled"
       Shell.FlyoutBehavior="Disabled">

  <TabBar>
    <ShellContent Title="입력" ContentTemplate="{DataTemplate views:CapturePage}" Route="capture" />
    <ShellContent Title="달력" ContentTemplate="{DataTemplate views:CalendarPage}" Route="calendar" />
    <ShellContent Title="목록" ContentTemplate="{DataTemplate views:ListPage}" Route="list" />
    <ShellContent Title="설정" ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
  </TabBar>

</Shell>
