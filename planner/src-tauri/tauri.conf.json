{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "1.1.0",
  "identifier": "com.planner.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Planner",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "주간·월간 할일/일정 플래너",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
