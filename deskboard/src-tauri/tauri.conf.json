{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskBoard",
  "version": "0.1.0",
  "identifier": "com.koko8787.deskboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeskBoard",
        "width": 780,
        "height": 460,
        "minWidth": 420,
        "minHeight": 260,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "minimizable": false,
        "maximizable": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
